# --- Tietokanta ---
# pglite = paikallinen kehityskanta (.data/pglite), postgres = Supabase.
# Oletus: kehityksessä pglite, Vercelissä postgres (src/lib/config/deploy-env.ts).
DB_DRIVER=pglite
# Skogin oma Supabase-projekti (BLOCKERS 3): Connect → Transaction pooler, "Use IPv4 connection" päällä.
# Muoto: postgresql://postgres.<projekti>:<salasana>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Kirjautuminen ---
# dev = kehityskirjautuminen (käyttäjän valinta listasta, EI tuotantoon), auth0 = Auth0
AUTH_MODE=dev
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32 satunnaista tavua hex-muodossa
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# Käyttäjien kutsu: mock = Auth0:aan ei kutsuta (oletus), auth0 = tunnus luodaan
# Auth0 Management API:lla. Oma kone-kone-sovellus, oikeudet read:users,
# create:users ja create:user_tickets.
AUTH0_ADMIN_MODE=mock
# AUTH0_MGMT_CLIENT_ID=
# AUTH0_MGMT_CLIENT_SECRET=
# AUTH0_DB_CONNECTION=Username-Password-Authentication

# --- Sähköposti (kutsut) ---
# mock = ei lähetetä (oletus), resend = Resend (resend.com)
EMAIL_MODE=mock
# RESEND_API_KEY=
# EMAIL_FROM=Skog <skog@adepta.fi>

# --- Evästeiden allekirjoitus ja kenttäsalaus (32 satunnaista tavua base64) ---
# Tuotannossa pakollisia. Kehityksessä käytetään kiinteää avainta.
SESSION_SECRET=
FIELD_ENCRYPTION_KEY=

# --- Päivittäinen ping (vercel.json) ---
# Vercel lähettää tämän cron-kutsussa. Ilman arvoa ping on kaikille avoin.
CRON_SECRET=
# Muut pidettävät projektit omilla anon-avaimillaan
# SUPABASE_KASAMASTER_URL=
# SUPABASE_KASAMASTER_ANON_KEY=

# --- Tiedostot (tositteet ja raportit) ---
# local = .data/storage (oletus), supabase = Skogin oman projektin yksityinen ämpäri documents
STORAGE_MODE=local
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Tiedonsiirto vanhasta Skogista (npm run tuo:vanha) ---
# Vanhan skog-projektin tietokantaosoite. Luetaan vain lukutilassa.
# LEGACY_DATABASE_URL=
